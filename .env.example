# Copy this file to .env and fill in your values.  Never commit .env.

# ── Airflow ────────────────────────────────────────────────
AIRFLOW_UID=50000
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=

# ── AWS S3 (raw layer) ─────────────────────────────────────
S3_BUCKET=your-ecommerce-data-lake
# URL-encode the secret key if it contains special characters (/ → %2F, + → %2B)
AIRFLOW_CONN_AWS_DEFAULT=aws://YOUR_ACCESS_KEY_ID:YOUR_SECRET_ACCESS_KEY@/?region_name=ap-south-1

# ── PostgreSQL (staging + warehouse) ───────────────────────
STAGING_USER=staging_user
STAGING_PASSWORD=change_me
STAGING_DB=ecommerce_staging
AIRFLOW_CONN_POSTGRES_STAGING=postgresql://staging_user:change_me@postgres_staging:5432/ecommerce_staging
